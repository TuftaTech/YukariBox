<?xml version="1.0" encoding="utf-8"?>
<!--
  Belt-and-suspenders alongside android:allowBackup="false": keep the credential
  stores (settings.json, subscriptions.json) and any on-disk logs out of both
  cloud backup and Android 12+ device-to-device transfer, so proxy secrets never
  leave the device through a backup channel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
